---
// src/components/Nav.astro
interface Props {
  active?: string;
}
const { active = 'home' } = Astro.props;

const items = [
  { key: 'home',     label: 'Front Page',   href: '/' },
  { key: 'seahawks', label: 'Seahawks',     href: '/teams/seahawks' },
  { key: 'mariners', label: 'Mariners',     href: '/teams/mariners' },
  { key: 'kraken',   label: 'Kraken',       href: '/teams/kraken' },
  { key: 'sonics',   label: 'Sonics Watch', href: '/teams/sonics' },
  { key: 'retro',    label: 'Arcade',        href: '/retro' },
  { key: 'columns',  label: 'Columns',      href: '/columns' },
];
---

<nav class="bg-ink border-t-2 border-ink">
  <div class="container-fix flex justify-center gap-9 py-3 max-md:flex-wrap max-md:gap-x-5 max-md:gap-y-2">
    {items.map((item) => (
      <a
        href={item.href}
        class:list={[
          'font-mast text-[13px] uppercase tracking-[0.02em] transition-colors',
          active === item.key ? 'text-fog' : 'text-cream hover:text-rust',
        ]}
      >
        {item.label}
      </a>
    ))}
  </div>
</nav>
