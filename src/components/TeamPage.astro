---
// src/components/TeamPage.astro
// Shared layout for team pages: hero band, team articles, team wires.

import rssData from '../data/rss-feed.json';
import { authorHref } from '../config';

interface ArticleSummary {
  slug: string;
  title: string;
  deck?: string;
  publishDate: Date;
  tag: string;
  author: string;
  readMinutes?: number;
}

interface Props {
  teamKey: 'seahawks' | 'mariners' | 'kraken' | 'sonics';
  teamName: string;
  sport: string;
  tagline: string;
  articles: ArticleSummary[];
}

const { teamKey, teamName, sport, tagline, articles } = Astro.props;

const wires = rssData.items
  .filter((item) => item.team === teamKey)
  .slice(0, 10);

function timeAgo(iso: string): string {
  const then = new Date(iso).getTime();
  const diff = Date.now() - then;
  const hours = Math.floor(diff / (1000 * 60 * 60));
  if (hours < 1) return 'Just now';
  if (hours < 24) return `${hours} hour${hours === 1 ? '' : 's'} ago`;
  const days = Math.floor(hours / 24);
  if (days === 1) return 'Yesterday';
  if (days < 7) return `${days} days ago`;
  return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<section class="border-b-4 border-double border-ink py-10">
  <div class="container-fix">
    <div class="flex items-baseline justify-between gap-6 max-md:flex-col max-md:items-start max-md:gap-3 pb-6 border-b border-ink">
      <div>
        <div class="kicker mb-2">Section &middot; {sport}</div>
        <h1 class="font-display text-[23px] leading-[1.25] tracking-[0.01em] text-ink max-md:text-[17px]">
          {teamName}
        </h1>
      </div>
      <p class="font-caslon text-[10px] leading-relaxed text-slate max-w-[420px] text-right max-md:text-left">
        {tagline}
      </p>
    </div>
  </div>
</section>

<section class="py-10 border-b-4 border-double border-ink">
  <div class="container-fix">
    <div class="grid grid-cols-[1fr_360px] gap-10 max-lg:grid-cols-1">
      <div>
        <div class="flex items-center gap-4 mb-6 pb-2 border-b-2 border-ink">
          <h2 class="font-mast text-[16px] text-forest tracking-[0.02em]">FROM THE DESK</h2>
          <div class="flex-1 h-px bg-ink"></div>
          <div class="meta-line">Original Writing</div>
        </div>

        {articles.length === 0 ? (
          <p class="font-body text-slate italic py-8">
            No published articles for the {teamName} yet. New columns will appear here when published.
          </p>
        ) : (
          <div class="space-y-8">
            {articles.map((article) => (
              <article class="pb-8 border-b border-black/15 last:border-b-0">
                <div class="kicker mb-2">{article.tag}</div>
                <h3 class="font-display text-[13px] leading-[1.4] tracking-[0.01em] mb-3 text-ink max-md:text-[11px]">
                  <a href={`/articles/${article.slug}`} class="hover:text-rust">{article.title}</a>
                </h3>
                {article.deck && (
                  <p class="font-caslon text-[9px] text-slate mb-3 leading-relaxed">
                    {article.deck}
                  </p>
                )}
                <div class="meta-line">
                  By <a href={authorHref(article.author)} class="text-ink font-bold hover:text-rust">{article.author}</a>
                  &middot; {formatDate(article.publishDate)}
                  {article.readMinutes && <> &middot; {article.readMinutes} min read</>}
                </div>
              </article>
            ))}
          </div>
        )}
      </div>

      <aside>
        <div class="section-label-tag mb-[14px]">From the Wires &middot; {teamName}</div>
        {wires.length === 0 ? (
          <p class="font-body text-slate italic text-[9px] leading-[1.6] py-4">
            No recent {teamName} items in the wires. The aggregator refreshes every two hours.
          </p>
        ) : (
          <div>
            {wires.map((item) => (
              <div class="dashed-border border-x-0 border-t-0 py-3 last:border-b-0">
                <div class="font-ui text-[10px] uppercase tracking-[0.12em] text-rust font-bold mb-1">
                  {item.source}
                </div>
                <div class="font-caslon text-[9px] leading-[1.5] font-bold">
                  <a href={item.link} target="_blank" rel="noopener noreferrer" class="hover:text-rust">
                    {item.title}
                  </a>
                </div>
                <div class="font-ui text-[10px] text-slate mt-1 tracking-[0.05em]">
                  {timeAgo(item.isoDate)}
                </div>
              </div>
            ))}
          </div>
        )}
      </aside>
    </div>

    <div class="mt-10 text-center">
      <a href="/" class="font-pixel text-rust text-[18px] hover:text-forest">&laquo; Back to Front Page</a>
    </div>
  </div>
</section>
