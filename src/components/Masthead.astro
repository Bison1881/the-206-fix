---
// src/components/Masthead.astro
// Date and edition are computed at BUILD time, pinned to Seattle time
// (America/Los_Angeles) so they don't drift with the UTC build server.
// The site rebuilds every ~2 hours via the RSS bot, so these stay fresh.

const TZ = 'America/Los_Angeles';
const now = new Date();

// Full weekday + date, in Seattle time.
const dateString = now.toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: TZ,
});

// Seattle hour (0-23), read via Intl so it respects the timezone.
const seattleHour = Number(
  new Intl.DateTimeFormat('en-US', {
    hour: 'numeric',
    hour12: false,
    timeZone: TZ,
  }).format(now)
);

// Two-way AM/PM split: before noon = Morning, noon onward = Evening.
const edition = seattleHour < 12 ? 'Morning Edition' : 'Evening Edition';
---

<header class="border-b-4 border-double border-ink pt-8 pb-5 text-center relative">
  <div class="container-fix">
    <div class="flex justify-between font-mast text-[8px] uppercase tracking-[0.1em] mb-[18px] text-slate max-md:text-[7px]">
      <span>Independent &middot; Pacific Northwest</span>
      <span>Retro &middot; Sports &middot; 206</span>
    </div>

    <h1 class="nameplate text-ink mb-2 pixel-shadow leading-none">
      <span class="seg">The</span> <span class="num">206</span> <span class="seg">Fix</span>
    </h1>

    <div class="font-mast text-[9px] uppercase tracking-[0.1em] text-slate mb-4 leading-relaxed">
      A companion paper for Seattle sports and the games we grew up on.
    </div>

    <div class="flex justify-center items-center gap-6 font-mast text-[8px] uppercase tracking-[0.1em] text-ink pt-3 border-t border-ink mt-[14px] max-md:text-[7px] max-md:gap-3">
      <span>Seattle, Washington</span>
      <span class="text-rust">&#9632;</span>
      <span>{dateString}</span>
      <span class="text-rust">&#9632;</span>
      <span>{edition}</span>
    </div>
  </div>
</header>
