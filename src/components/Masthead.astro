---
// src/components/Masthead.astro
const today = new Date();
const dateString = today.toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

function getEdition(date: Date): string {
  const hour = date.getHours();
  if (hour < 12) return 'Morning Edition';
  if (hour < 17) return 'Afternoon Edition';
  return 'Evening Edition';
}
---

<header class="border-b-4 border-double border-ink pt-8 pb-5 text-center relative">
  <div class="container-fix">
    <div class="flex justify-between font-mast text-[8px] uppercase tracking-[0.1em] mb-[18px] text-slate max-md:text-[7px]">
      <span>Independent &middot; Pacific Northwest</span>
      <span>Retro &middot; Sports &middot; 206</span>
    </div>

    <h1 class="font-mast text-[52px] leading-none text-forest mb-2 pixel-shadow tracking-[-0.02em] max-md:text-[32px]">
      THE&nbsp;206&nbsp;FIX
    </h1>

    <div class="font-caslon italic text-[18px] text-slate mb-4">
      A companion paper for Seattle sports and the games we grew up on.
    </div>

    <div class="flex justify-center items-center gap-6 font-mast text-[8px] uppercase tracking-[0.1em] text-ink pt-3 border-t border-ink mt-[14px] max-md:text-[7px] max-md:gap-3">
      <span>Seattle, Washington</span>
      <span class="text-rust">&#9632;</span>
      <span>{dateString}</span>
      <span class="text-rust">&#9632;</span>
      <span>{getEdition(today)}</span>
    </div>
  </div>
</header>
