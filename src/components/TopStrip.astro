---
// src/components/TopStrip.astro
// Volume = years since launch (2026 = Volume I).
// No. = day-of-year (Jan 1 = 001), zero-padded to 3 digits.

const LAUNCH_YEAR = 2026;
const TZ = 'America/Los_Angeles';

function toRoman(num: number): string {
  const map: [number, string][] = [
    [1000, 'M'], [900, 'CM'], [500, 'D'], [400, 'CD'],
    [100, 'C'], [90, 'XC'], [50, 'L'], [40, 'XL'],
    [10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I'],
  ];
  let result = '';
  for (const [value, numeral] of map) {
    while (num >= value) {
      result += numeral;
      num -= value;
    }
  }
  return result || 'I';
}

// Read the Seattle-local Y/M/D, then compute day-of-year from those parts
// so the issue number doesn't jump a day due to the UTC build server.
const parts = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric', month: '2-digit', day: '2-digit', timeZone: TZ,
}).format(new Date()); // yields "YYYY-MM-DD"
const [sYear, sMonth, sDay] = parts.split('-').map(Number);

const startOfYear = Date.UTC(sYear, 0, 0);
const todayUTC = Date.UTC(sYear, sMonth - 1, sDay);
const dayNum = Math.floor((todayUTC - startOfYear) / 86400000);

const volume = toRoman(sYear - LAUNCH_YEAR + 1);
const issue = String(dayNum).padStart(3, '0');
---

<div class="bg-ink text-cream font-mast text-[8px] tracking-[0.08em] uppercase py-[10px]">
  <div class="container-fix flex justify-between items-center">
    <span>Volume {volume} &middot; No. {issue}</span>
    <span class="flex gap-[14px] max-md:gap-[10px]">
      <a href="/about" class="hover:text-fog">About</a>
      <a href="https://www.youtube.com/@the206fix" class="hover:text-fog">YouTube</a>
      <a href="/rss.xml" class="hover:text-fog">RSS</a>
      <a href="/columns" class="hover:text-fog">Archive</a>
    </span>
  </div>
</div>
