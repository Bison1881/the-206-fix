---
// src/pages/retro.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const retro = (await getCollection('retro', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}

// Featured = flagged, else newest.
const featured = retro.find((r) => r.data.featured) ?? retro[0] ?? null;
const rest = retro.filter((r) => r.slug !== featured?.slug);

const featuredYoutube = featured?.data.youtubeId
  ? `https://www.youtube.com/watch?v=${featured.data.youtubeId}`
  : 'https://www.youtube.com/@the206fix';
---

<BaseLayout title="The Arcade — The 206 Fix" description="The Arcade. Companion writing to The 206 Fix on YouTube: no-commentary retro sports gameplay and the history behind it." activeNav="retro">
  <section class="border-b-4 border-double border-ink py-10">
    <div class="container-fix">
      <div class="font-mast text-[10px] text-rust tracking-[0.05em] mb-3">&#9658; THE ARCADE</div>
      <h1 class="font-display text-[22px] leading-[1.25] tracking-[0.01em] text-ink max-md:text-[17px]">The Arcade</h1>
      <p class="font-caslon text-[10px] leading-relaxed text-slate mt-3 max-w-[640px]">
        Companion to the channel. No-commentary retro sports gameplay and the history behind the games we grew up on.
      </p>
    </div>
  </section>

  {featured && (
    <section class="py-10 border-b border-ink">
      <div class="container-fix">
        <div class="bg-ink text-cream p-8 relative">
          <div class="absolute inset-2 border-2 border-dashed border-fog pointer-events-none"></div>
          <div class="font-mast text-[10px] text-rust mb-4 tracking-[0.05em] relative">&#9658; NOW PLAYING</div>
          <h2 class="font-display text-[16px] leading-[1.35] tracking-[0.01em] mb-3 text-cream relative max-md:text-[13px]">
            <a href={`/retro/${featured.slug}`} class="hover:text-fog">{featured.data.title}</a>
          </h2>
          {featured.data.deck && (
            <p class="font-caslon text-[9px] leading-relaxed text-fog mb-5 relative max-w-[640px]">{featured.data.deck}</p>
          )}
          <div class="flex flex-wrap gap-5 items-center relative">
            <a href={`/retro/${featured.slug}`} class="font-pixel text-[10px] bg-rust text-cream px-[18px] py-[10px] hover:bg-cream hover:text-ink">Read &#9658;</a>
            <a href={featuredYoutube} target="_blank" rel="noopener noreferrer" class="font-pixel text-[10px] text-fog hover:text-cream">Watch on YouTube &#9654;</a>
          </div>
          <div class="font-ui text-[11px] text-fog tracking-[0.12em] uppercase pt-5 border-t border-fog mt-6 relative">
            {featured.data.episodeNumber && <>Episode {String(featured.data.episodeNumber).padStart(3, '0')} &middot; </>}
            {formatDate(featured.data.publishDate)}
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="py-10">
    <div class="container-fix">
      {rest.length === 0 ? (
        <p class="font-body text-slate italic py-4">{featured ? 'More episodes coming soon.' : 'No retro pieces published yet.'}</p>
      ) : (
        <>
          <div class="flex items-center gap-4 mb-6">
            <h2 class="font-mast text-[16px] text-forest">ALL EPISODES</h2>
            <div class="flex-1 h-px bg-ink"></div>
          </div>
          <div class="grid grid-cols-2 gap-x-8 gap-y-7 max-md:grid-cols-1">
            {rest.map((piece) => (
              <article class="pb-7 border-b border-black/15">
                <div class="font-mast text-[9px] text-rust tracking-[0.05em] mb-2">
                  {piece.data.episodeNumber ? `EP ${String(piece.data.episodeNumber).padStart(3, '0')}` : piece.data.series ?? 'ARCADE'}
                </div>
                <h3 class="font-display text-[11px] leading-[1.4] tracking-[0.01em] mb-2 text-ink">
                  <a href={`/retro/${piece.slug}`} class="hover:text-rust">{piece.data.title}</a>
                </h3>
                {piece.data.deck && (
                  <p class="font-body text-[9px] text-slate mb-2 leading-[1.6]">{piece.data.deck}</p>
                )}
                <div class="meta-line">
                  {piece.data.game} &middot; {formatDate(piece.data.publishDate)}
                </div>
              </article>
            ))}
          </div>
        </>
      )}

      <div class="mt-10 text-center">
        <a href="/" class="font-pixel text-rust text-[18px] hover:text-forest">&laquo; Back to Front Page</a>
      </div>
    </div>
  </section>
</BaseLayout>
