---
// src/pages/retro/[...slug].astro
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const retro = await getCollection('retro', ({ data }) => !data.draft);
  return retro.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'retro'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const publishedString = entry.data.publishDate.toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const hasVideo = entry.data.youtubeId && entry.data.youtubeId.trim().length > 0;
---

<BaseLayout title={`${entry.data.title} — The 206 Fix`} description={entry.data.deck} activeNav="retro">
  <article class="container-fix py-12 max-w-[820px]">
    <div class="font-mast text-[10px] text-rust tracking-[0.05em] mb-4">
      &#9658; THE ARCADE
      {entry.data.episodeNumber && <> &middot; EP {String(entry.data.episodeNumber).padStart(3, '0')}</>}
    </div>

    <h1 class="font-pixel text-[44px] leading-[1.05] mb-4 text-ink max-md:text-[32px]">
      {entry.data.title}
    </h1>

    {entry.data.deck && (
      <p class="font-caslon italic text-[22px] text-slate mb-6 pb-5 border-b border-ink">
        {entry.data.deck}
      </p>
    )}

    <div class="meta-line mb-10 flex flex-wrap gap-x-4 gap-y-2">
      <span>By <strong class="text-ink">{entry.data.author}</strong></span>
      <span>{publishedString}</span>
      <span>{entry.data.game}</span>
      {entry.data.readMinutes && <span>{entry.data.readMinutes} min read</span>}
    </div>

    {hasVideo && (
      <div class="mb-10">
        <div class="relative w-full" style="padding-bottom: 56.25%;">
          <iframe
            class="absolute inset-0 w-full h-full border-4 border-ink"
            src={`https://www.youtube.com/embed/${entry.data.youtubeId}`}
            title={entry.data.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    )}

    <div class="prose-article font-body text-[19px] leading-[1.7]">
      <Content />
    </div>

    <div class="mt-12 pt-6 border-t border-ink flex flex-wrap gap-6 justify-between">
      <a href="/retro" class="font-pixel text-rust hover:text-forest text-[18px]">&laquo; All Retro</a>
      <a href="https://www.youtube.com/@the206fix" target="_blank" rel="noopener noreferrer" class="font-pixel text-rust hover:text-forest text-[18px]">Watch on YouTube &#9654;</a>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .prose-article p {
    margin-bottom: 1.2em;
  }
  .prose-article h2 {
    font-family: 'Playfair Display', serif;
    font-weight: 800;
    font-size: 30px;
    margin-top: 2em;
    margin-bottom: 0.5em;
    color: var(--forest);
  }
  .prose-article h3 {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: 22px;
    margin-top: 1.5em;
    margin-bottom: 0.4em;
  }
  .prose-article blockquote {
    border-left: 3px solid var(--rust);
    padding: 0.5em 0 0.5em 1.4em;
    margin: 1.5em 0;
    font-style: italic;
    color: var(--slate);
  }
  .prose-article a {
    color: var(--rust);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .prose-article a:hover {
    color: var(--forest);
  }
  .prose-article ul, .prose-article ol {
    margin: 1em 0 1.2em 1.4em;
    list-style: disc;
  }
  .prose-article ol { list-style: decimal; }
  .prose-article li { margin-bottom: 0.4em; }
</style>
