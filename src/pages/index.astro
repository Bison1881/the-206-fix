---
// src/pages/index.astro
// The front page: one page, two columns under the masthead.
//   Left  — the owner's YouTube videos (latest as lead, older stacked below).
//   Right — the aggregated Seattle sports wire.
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoColumn from '../components/VideoColumn.astro';
import Wire from '../components/Wire.astro';
import { youtubeWatchUrl, youtubeThumb } from '../config';

const videos = (await getCollection('videos', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

function toCard(entry: CollectionEntry<'videos'>) {
  return {
    title: entry.data.title,
    deck: entry.data.deck,
    episodeNumber: entry.data.episodeNumber,
    game: entry.data.game,
    publishDate: entry.data.publishDate,
    url: youtubeWatchUrl(entry.data.youtubeId),
    image: entry.data.customImage ?? youtubeThumb(entry.data.youtubeId),
  };
}

const cards = videos.map(toCard);
const lead = cards[0] ?? null;
const rest = cards.slice(1);
---

<BaseLayout title="The 206 Fix — Seattle Sports & Retro Gaming">
  <section class="py-10">
    <div class="container-fix">
      <div class="grid grid-cols-[1fr_340px] gap-10 items-start max-lg:grid-cols-1">
        <VideoColumn lead={lead} rest={rest} />
        <Wire />
      </div>
    </div>
  </section>
</BaseLayout>
