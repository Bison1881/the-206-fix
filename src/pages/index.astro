---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import Ornament from '../components/Ornament.astro';
import FromTheDesk from '../components/FromTheDesk.astro';
import TheArcade from '../components/TheArcade.astro';

// ----- ARTICLES -----
const allArticles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// Lead = explicitly flagged lead, else most recent
const leadEntry = allArticles.find((a) => a.data.lead) ?? allArticles[0] ?? null;

let leadPayload = null;
if (leadEntry) {
  const { Content } = await leadEntry.render();
  // We render the body to HTML via Astro's `render` and the slot pattern, but
  // for the column layout we need the raw HTML string. Easiest path: pass the
  // first few paragraphs of the body as HTML rendered server-side.
  // For the v1 home page we keep the lead body to ~3 short paragraphs and let
  // the article detail page show the full piece.
  leadPayload = {
    slug: leadEntry.slug,
    title: leadEntry.data.title,
    deck: leadEntry.data.deck,
    author: leadEntry.data.author,
    tag: leadEntry.data.tag,
    readMinutes: leadEntry.data.readMinutes,
    // For the column layout, we render an excerpt-as-HTML preview rather than
    // the entire article. The first paragraph gets the drop-cap class.
    bodyHtml: buildLeadExcerpt(leadEntry.body),
  };
}

function buildLeadExcerpt(markdownBody: string): string {
  const paragraphs = markdownBody
    .split(/\n\s*\n/)
    .filter((p) => p.trim().length > 0 && !p.trim().startsWith('#'))
    .slice(0, 3);

  return paragraphs
    .map((p, i) => {
      const cleaned = p.trim().replace(/\n/g, ' ');
      const klass = i === 0 ? 'dropcap' : '';
      return `<p class="${klass}">${cleaned}</p>`;
    })
    .join('\n');
}

// ----- FROM THE DESK (next 3 most recent non-lead articles) -----
const deskStories = allArticles
  .filter((a) => a.slug !== leadEntry?.slug)
  .slice(0, 3)
  .map((a) => ({
    slug: a.slug,
    title: a.data.title,
    excerpt: a.data.deck ?? a.body.split('\n').find((line) => line.trim().length > 0)?.slice(0, 200) ?? '',
    tag: a.data.tag,
    author: a.data.author,
    readMinutes: a.data.readMinutes,
  }));

// ----- THE ARCADE -----
const allRetro = (await getCollection('retro', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const retroFeatureEntry = allRetro.find((r) => r.data.featured) ?? allRetro[0] ?? null;
const retroFeature = retroFeatureEntry
  ? {
      slug: retroFeatureEntry.slug,
      title: retroFeatureEntry.data.title,
      deck: retroFeatureEntry.data.deck,
      episodeNumber: retroFeatureEntry.data.episodeNumber,
      youtubeId: retroFeatureEntry.data.youtubeId,
      publishDate: retroFeatureEntry.data.publishDate,
    }
  : null;

const retroCompanions = allRetro
  .filter((r) => r.slug !== retroFeatureEntry?.slug)
  .slice(0, 4)
  .map((r) => ({
    slug: r.slug,
    title: r.data.title,
    game: r.data.game,
    readMinutes: r.data.readMinutes,
  }));
---

<BaseLayout title="The 206 Fix — Seattle Sports & Retro Gaming" activeNav="home">
  <HeroSection lead={leadPayload} />
  <Ornament />
  <FromTheDesk stories={deskStories} />
  <TheArcade feature={retroFeature} companions={retroCompanions} />
</BaseLayout>
