---
// src/pages/teams/kraken.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TeamPage from '../../components/TeamPage.astro';

const articles = (await getCollection('articles', ({ data }) =>
  !data.draft && data.team === 'kraken'
))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .map((entry) => ({
    slug: entry.slug,
    title: entry.data.title,
    deck: entry.data.deck,
    publishDate: entry.data.publishDate,
    tag: entry.data.tag,
    author: entry.data.author,
    readMinutes: entry.data.readMinutes,
  }));
---

<BaseLayout
  title="Kraken — The 206 Fix"
  description="Seattle Kraken coverage, original writing, and aggregated news from The 206 Fix."
  activeNav="kraken"
>
  <TeamPage
    teamKey="kraken"
    teamName="The Kraken"
    sport="NHL"
    tagline="The newest banner in a town that takes its banners seriously."
    articles={articles}
  />
</BaseLayout>
