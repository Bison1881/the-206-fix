---
// src/pages/teams/sonics.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TeamPage from '../../components/TeamPage.astro';

const articles = (await getCollection('articles', ({ data }) =>
  !data.draft && data.team === 'sonics'
))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .map((entry) => ({
    slug: entry.slug,
    title: entry.data.title,
    deck: entry.data.deck,
    publishDate: entry.data.publishDate,
    tag: entry.data.tag,
    author: entry.data.author,
    readMinutes: entry.data.readMinutes,
  }));

// Countdown to the targeted return date (start of 2028-29 NBA season is roughly October 2028).
const targetDate = new Date('2028-10-24T00:00:00');
const daysUntilTipoff = Math.max(0, Math.ceil((targetDate.getTime() - Date.now()) / (1000 * 60 * 60 * 24)));
---

<BaseLayout
  title="Sonics Watch — The 206 Fix"
  description="Tracking the return of the SuperSonics. Coverage of the 2028-29 expansion, Climate Pledge Arena, and what it means for Seattle."
  activeNav="sonics"
>
  <!-- Sonics Watch banner: emphasizes the countdown nature of the section -->
  <section class="border-b border-ink py-6 bg-forest text-cream">
    <div class="container-fix flex items-center justify-between gap-6 max-md:flex-col max-md:items-start max-md:gap-3">
      <div>
        <div class="font-mast text-[10px] text-rust tracking-[0.1em] mb-2">SONICS WATCH</div>
        <div class="font-pixel text-[26px] leading-tight">The clock is running.</div>
      </div>
      <div class="text-right max-md:text-left">
        <div class="font-mast text-[36px] text-cream pixel-shadow-sm">{daysUntilTipoff.toLocaleString()}</div>
        <div class="font-ui text-[11px] uppercase tracking-[0.15em] text-fog mt-2">
          days to 2028-29 tip-off (target)
        </div>
      </div>
    </div>
  </section>

  <TeamPage
    teamKey="sonics"
    teamName="Sonics Watch"
    sport="NBA &middot; Expansion"
    tagline="A homecoming that has been written in green and gold for nearly two decades. We are tracking every step."
    articles={articles}
  />
</BaseLayout>
