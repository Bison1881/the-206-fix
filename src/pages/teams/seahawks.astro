---
// src/pages/teams/seahawks.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TeamPage from '../../components/TeamPage.astro';

const articles = (await getCollection('articles', ({ data }) =>
  !data.draft && data.team === 'seahawks'
))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .map((entry) => ({
    slug: entry.slug,
    title: entry.data.title,
    deck: entry.data.deck,
    publishDate: entry.data.publishDate,
    tag: entry.data.tag,
    author: entry.data.author,
    readMinutes: entry.data.readMinutes,
  }));
---

<BaseLayout
  title="Seahawks — The 206 Fix"
  description="Seattle Seahawks coverage, original writing, and aggregated news from The 206 Fix."
  activeNav="seahawks"
>
  <TeamPage
    teamKey="seahawks"
    teamName="The Seahawks"
    sport="NFL"
    tagline="Twelve flags, four decades of football, and a city that knows the difference between loud and ready."
    articles={articles}
  />
</BaseLayout>
