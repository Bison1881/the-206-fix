---
// src/pages/teams/mariners.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TeamPage from '../../components/TeamPage.astro';

const articles = (await getCollection('articles', ({ data }) =>
  !data.draft && data.team === 'mariners'
))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .map((entry) => ({
    slug: entry.slug,
    title: entry.data.title,
    deck: entry.data.deck,
    publishDate: entry.data.publishDate,
    tag: entry.data.tag,
    author: entry.data.author,
    readMinutes: entry.data.readMinutes,
  }));
---

<BaseLayout
  title="Mariners — The 206 Fix"
  description="Seattle Mariners coverage, original writing, and aggregated news from The 206 Fix."
  activeNav="mariners"
>
  <TeamPage
    teamKey="mariners"
    teamName="The Mariners"
    sport="MLB"
    tagline="Forty-eight summers, one franchise, and a fan base that has earned the right to be cautiously optimistic."
    articles={articles}
  />
</BaseLayout>
