# Claude Code's per-machine settings. The `.local.` infix is its convention for
# personal config — shared project settings belong in .claude/settings.json.
# This one accumulates an allowlist of absolute paths under a specific user's
# home directory, which has no business in a public repo.
.claude/settings.local.json
