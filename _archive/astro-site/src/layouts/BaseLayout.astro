---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import TopStrip from '../components/TopStrip.astro';
import Masthead from '../components/Masthead.astro';
import Ticker from '../components/Ticker.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  // When true, emits <meta name="robots" content="noindex"> so search engines
  // skip the page. Used to keep the About page reachable by direct URL only.
  noindex?: boolean;
}

const {
  title,
  description = 'The 206 Fix - Seattle sports and retro gaming, with a pixel heart. Seattle sports games on the NES/SNES, played on The 206 Fix YouTube channel, plus the Seattle sports wire.',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="The 206 Fix" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <TopStrip />
    <Masthead />
    <Ticker />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
